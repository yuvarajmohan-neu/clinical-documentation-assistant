# No secrets committed — this file lists every *_PROVIDER setting and obviously-fake demo values.
# Copy to .env (git-ignored) and fill in real values for anything beyond the local demo.

# --- Database ---
DATABASE_URL=postgresql+psycopg://cda:cda-dev-password@localhost:5432/cda

# --- Auth ---
AUTH_PROVIDER=dev
# dev provider: which demo user to impersonate when AUTH_PROVIDER=dev
DEV_USER=art31.clinician

# oidc provider (Keycloak locally; swap to Entra ID by changing these four + frontend lib)
OIDC_ISSUER=http://localhost:8080/realms/jb-demo
OIDC_AUDIENCE=cda-api
OIDC_ROLE_CLAIM=realm_access.roles
# OIDC_TENANT_ID=   # set when OIDC_ISSUER points at Entra ID

# Demo Keycloak users (synthetic only — CLAUDE.md non-negotiable rule)
KEYCLOAK_DEMO_PASSWORD=demo-pass-not-real

# --- Audit ---
AUDIT_PROVIDER=postgres

# --- Other provider capabilities (owned by P3/P4, listed here for completeness) ---
LLM_PROVIDER=fake
PARSER_PROVIDER=docling
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
SEARCH_PROVIDER=pgvector
BLOB_PROVIDER=local
SPEECH_PROVIDER=browser
SECRETS_PROVIDER=env
